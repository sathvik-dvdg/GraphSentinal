# ── .gitattributes ─────────────────────────────────────────────────────────────
# Force LF line endings for shell scripts so they aren't corrupted by
# Windows autocrlf when checked out on Windows and run inside Linux containers.
# Without this, bash inside the container fails with:
#   /usr/local/bin/docker-entrypoint.sh: \r: bad interpreter
# ──────────────────────────────────────────────────────────────────────────────

# Shell scripts must always have LF line endings in the repo
*.sh       text eol=lf

# Dockerfiles and YAML are platform-agnostic — let them use native endings
Dockerfile text
*.yml      text
*.yaml     text

# Hash-bearing ML artefacts: their sha256 digests are recorded in ML/MANIFEST.json
# and INTEGRATION.md, so git must store and check them out BYTE FOR BYTE. With
# core.autocrlf=true and no attribute, git may normalise their line endings on a
# later add or renormalise, and every recorded digest would silently stop
# matching the file. Top-level ML/ only; the package's own files are unaffected.
ML/*.json  -text
ML/*.csv   -text

# Copy to frontend/.env for the manual path (RUN_GUIDE.md section 3).
# Compose does not read this file; it uses .env.docker.
# Never put a secret in a VITE_ variable: the dev server and the build both
# deliver every VITE_ value to the browser.
VITE_BACKEND_URL=http://localhost:8000
VITE_USE_MOCK=false

origin BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SQLITE_PATH=./graphsentinel.db
THREAT_THRESHOLD=0.75
POLL_INTERVAL_SECONDS=5

WEIGHTS_PATH=../ML/GraphSage-model/graphsage_weights.pt
MODEL_SOURCE_PATH=../ml/src
NODE_FEATURE_COUNT=7
REQUIRE_ML_MODEL=false
DEMO_ALLOW_MOCK_ML=true
SCALER_PATH=../ML/GraphSage-model/scaler.pkl
USE_SCALER_FOR_INFERENCE=false

# Note for WSL users: If Ganache is running on Windows, use your Windows Host IP instead of 127.0.0.1
GANACHE_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
BLOCKCHAIN_TX_TIMEOUT_SECONDS=5

BACKEND_API_TOKEN=change-me-for-demo
MAX_ANALYZE_FLOWS=5000
ANALYZE_RATE_LIMIT_PER_MINUTE=30

ENFORCEMENT_MODE=simulated
ENFORCEMENT_SWITCH=s1
MININET_CIDR=10.0.0.0/24
DEMO_FALLBACK_FLOWS=false


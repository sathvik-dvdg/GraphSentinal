# ── .env.docker — GraphSentinel Docker environment template ───────────────────
# This file is COMMITTED. It contains only safe defaults (no real secrets).
# Copy it if you need service-specific overrides:
#   cp .env.docker .env.docker.local   # gitignored, safe for real values
#
# The docker-compose.yml reads this file via env_file: .env.docker
# CONTRACT_ADDRESS is NOT set here — it is written at runtime by the
# blockchain container's entrypoint into /shared/contract_address.env
# and sourced by the backend entrypoint before uvicorn starts.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# SQLite path inside the container (named volume — isolated from host DB)
SQLITE_PATH=/app/data/graphsentinel.db
THREAT_THRESHOLD=0.75
POLL_INTERVAL_SECONDS=5

# ── ML Model (bind-mounted from ./ML/ in the repo) ───────────────────────────
WEIGHTS_PATH=/app/ML/GraphSage-model/graphsage_weights.pt
SCALER_PATH=/app/ML/GraphSage-model/scaler.pkl
MODEL_SOURCE_PATH=/app/ML/src
NODE_FEATURE_COUNT=7
REQUIRE_ML_MODEL=false
DEMO_ALLOW_MOCK_ML=true
USE_SCALER_FOR_INFERENCE=false

# ── Blockchain ────────────────────────────────────────────────────────────────
# GANACHE_URL uses the Docker Compose service name "blockchain" (internal DNS)
# This is different from local dev which uses http://127.0.0.1:8545
GANACHE_URL=http://blockchain:8545
# CONTRACT_ADDRESS is NOT set here — loaded at runtime from /shared/contract_address.env
CONTRACT_ADDRESS=
BLOCKCHAIN_TX_TIMEOUT_SECONDS=5

# ── API security ──────────────────────────────────────────────────────────────
# Change this for any non-demo deployment
BACKEND_API_TOKEN=change-me-for-demo

# ── Rate limiting ─────────────────────────────────────────────────────────────
MAX_ANALYZE_FLOWS=5000
ANALYZE_RATE_LIMIT_PER_MINUTE=30

# ── Enforcement ───────────────────────────────────────────────────────────────
# Always simulated in Docker — OVS/Mininet requires Linux kernel + root on host
ENFORCEMENT_MODE=simulated
ENFORCEMENT_SWITCH=s1
MININET_CIDR=10.0.0.0/24

# ── Demo mode ─────────────────────────────────────────────────────────────────
# IMPORTANT: DEMO_FALLBACK_FLOWS=true is the correct setting for Docker.
# Without Mininet/OVS, the backend uses synthetic demo flows to populate
# the graph and feed the GNN — this is the correct path for most team members.
# Set to false ONLY if you are running the full Mininet pipeline in WSL2.
DEMO_FALLBACK_FLOWS=true

# ── Frontend ──────────────────────────────────────────────────────────────────
# In Docker, the frontend proxy handles /api and /socket.io internally.
# VITE_BACKEND_URL is only used for direct (non-proxied) calls if any.
VITE_BACKEND_URL=http://localhost:8001
VITE_USE_MOCK=false
VITE_BACKEND_API_TOKEN=change-me-for-demo

# ── .env.docker — GraphSentinel Docker environment template ───────────────────
# This file is COMMITTED. It contains only safe defaults (no real secrets).
#
# docker-compose.yml loads this file, then optionally layers
# .env.docker.local on top (gitignored) if it exists — create that file to
# bridge to a real WSL2 Mininet daemon (DAEMON_TOKEN, ENFORCEMENT_MODE=ovs,
# DEMO_FALLBACK_FLOWS=false, THREAT_THRESHOLD, etc.) without touching this
# committed file or the repo-root .env (which is for local/WSL2 dev and is
# intentionally NOT read by docker-compose.yml's environment: block).
#   cp .env.docker .env.docker.local   # then edit real values in place
# CONTRACT_ADDRESS is NOT set here — it is written at runtime by the
# blockchain container's entrypoint into /shared/contract_address.env
# and sourced by the backend entrypoint before uvicorn starts.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# SQLite path inside the container (named volume — isolated from host DB)
SQLITE_PATH=/app/data/graphsentinel.db
THREAT_THRESHOLD=0.75
POLL_INTERVAL_SECONDS=5

# ── ML Model (bind-mounted from ./ML/ in the repo) ───────────────────────────
WEIGHTS_PATH=/app/ML/GraphSage-model/graphsage_weights.pt
SCALER_PATH=/app/ML/GraphSage-model/scaler.pkl
MODEL_SOURCE_PATH=/app/ML/src
NODE_FEATURE_COUNT=7
REQUIRE_ML_MODEL=false
DEMO_ALLOW_MOCK_ML=true
USE_SCALER_FOR_INFERENCE=false

# ── Blockchain ────────────────────────────────────────────────────────────────
# GANACHE_URL uses the Docker Compose service name "blockchain" (internal DNS)
# This is different from local dev which uses http://127.0.0.1:8545
GANACHE_URL=http://blockchain:8545
# CONTRACT_ADDRESS is NOT set here — loaded at runtime from /shared/contract_address.env
CONTRACT_ADDRESS=
BLOCKCHAIN_TX_TIMEOUT_SECONDS=5

# ── API security ──────────────────────────────────────────────────────────────
# Change this for any non-demo deployment
BACKEND_API_TOKEN=change-me-for-demo

# ── Operator login (Error.md #18/#27) ──────────────────────────────────────────
# Change both for any non-demo deployment
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=change-me-for-demo
SESSION_TTL_HOURS=8

# ── Rate limiting ─────────────────────────────────────────────────────────────
MAX_ANALYZE_FLOWS=5000
ANALYZE_RATE_LIMIT_PER_MINUTE=30

# ── Enforcement ───────────────────────────────────────────────────────────────
# Always simulated in Docker — OVS/Mininet requires Linux kernel + root on host
ENFORCEMENT_MODE=simulated
ENFORCEMENT_SWITCH=s1
MININET_CIDR=10.0.0.0/24

# ── Demo mode ─────────────────────────────────────────────────────────────────
# IMPORTANT: DEMO_FALLBACK_FLOWS=true is the correct setting for Docker.
# Without Mininet/OVS, the backend uses synthetic demo flows to populate
# the graph and feed the GNN — this is the correct path for most team members.
# Set to false ONLY in .env.docker.local, and only if you are running the
# full Mininet + enforcement-daemon pipeline in WSL2 (see DAEMON_TOKEN below).
DEMO_FALLBACK_FLOWS=true

# ── WSL2 daemon bridge (optional) ───────────────────────────────────────────
# The backend always attempts to reach backend/scripts/enforcement_daemon.py
# at host.docker.internal:50051 first, and only falls back to demo flows /
# simulated enforcement if that connection fails. This placeholder token lets
# a fresh `docker compose up` boot with no manual setup (the daemon will just
# be unreachable, which is expected). Put your real token in
# .env.docker.local to bridge to a real WSL2 daemon instance.
DAEMON_TOKEN=docker-default-unset

# ── CORS ──────────────────────────────────────────────────────────────────────
# The browser at :5174 calls the backend directly at VITE_BACKEND_URL (:8001),
# so the backend must allow that origin. Explicit here (matches config.py's
# default) so it doesn't depend on the default being picked up.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# The React app calls the backend directly at VITE_BACKEND_URL for both REST
# and the WebSocket (the Vite dev-server proxy is unreliable under the
# Docker + WSL2 bind-mount + polling-watcher combo — see api.js).
VITE_BACKEND_URL=http://localhost:8001
VITE_USE_MOCK=false
VITE_BACKEND_API_TOKEN=change-me-for-demo

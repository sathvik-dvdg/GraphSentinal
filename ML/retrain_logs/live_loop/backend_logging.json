{"version": 1, "disable_existing_loggers": false,
 "formatters": {"f": {"format": "%(asctime)s %(levelname)s %(name)s: %(message)s"}},
 "handlers": {"h": {"class": "logging.StreamHandler", "formatter": "f", "stream": "ext://sys.stdout"}},
 "loggers": {"graphsentinel": {"level": "INFO", "handlers": ["h"], "propagate": false},
             "uvicorn": {"level": "WARNING", "handlers": ["h"], "propagate": false}},
 "root": {"level": "WARNING", "handlers": ["h"]}}
